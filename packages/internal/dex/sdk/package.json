{
  "name": "@imtbl/dex-sdk",
  "description": "DEX Provider package for the Immutable SDK",
  "version": "0.0.0",
  "author": "Immutable",
  "browser": "dist/browser/index.js",
  "bugs": "https://github.com/immutable/ts-immutable-sdk/issues",
  "dependencies": {
    "@imtbl/config": "workspace:*",
    "@uniswap/sdk-core": "^3.0.1",
    "@uniswap/swap-router-contracts": "^1.3.1",
    "@uniswap/v3-sdk": "~3.10.0",
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@swc/core": "^1.4.2",
    "@swc/jest": "^0.2.37",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.4.3",
    "ts-node": "^10.9.1",
    "tsup": "^8.3.0",
    "typechain": "^8.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    "development": {
      "types": "./src/index.ts",
      "browser": "./dist/browser/index.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.js"
    },
    "default": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/immutable/ts-immutable-sdk#readme",
  "keywords": [
    "immutable"
  ],
  "license": "Apache-2.0",
  "main": "dist/node/index.cjs",
  "module": "dist/node/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": "immutable/ts-immutable-sdk.git",
  "scripts": {
    "build": "pnpm transpile && pnpm typegen",
    "generate-types": "typechain --target ethers-v6 --out-dir ./src/contracts/types ./src/contracts/ABIs/*.json",
    "lint": "eslint ./src --ext .ts --max-warnings=0",
    "lint:fix": "cd ../../../.. && pnpm wsrun -p @imtbl/dex-sdk -c lint --fix",
    "pack:root": "pnpm pack --pack-destination $(dirname $(pnpm root -w))",
    "test": "jest test",
    "test:watch": "jest --watch",
    "transpile": "tsup src/index.ts --config ../../../../tsup.config.js",
    "typecheck": "tsc --customConditions default --noEmit",
    "typegen": "tsc --customConditions default --emitDeclarationOnly --outDir dist/types"
  },
  "source": "src/index.ts",
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
