{
  "name": "@imtbl/audience-core",
  "description": "Shared core for Immutable Audience SDKs: transport, queue, cookie, context collection",
  "version": "0.0.0",
  "author": "Immutable",
  "browser": "dist/browser/index.js",
  "bugs": "https://github.com/immutable/ts-immutable-sdk/issues",
  "dependencies": {
    "@imtbl/metrics": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "^1.4.2",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.12",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.4.3",
    "tsup": "^8.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "browser": "./dist/browser/index.js",
        "require": "./dist/node/index.cjs",
        "default": "./dist/node/index.js"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "browser": "./dist/browser/index.js",
        "require": "./dist/node/index.cjs",
        "default": "./dist/node/index.js"
      }
    },
    "./internal": {
      "development": {
        "types": "./src/internal.ts",
        "browser": "./dist/browser/internal.js",
        "require": "./dist/node/internal.cjs",
        "default": "./dist/node/internal.js"
      },
      "default": {
        "types": "./dist/types/internal.d.ts",
        "browser": "./dist/browser/internal.js",
        "require": "./dist/node/internal.cjs",
        "default": "./dist/node/internal.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/immutable/ts-immutable-sdk#readme",
  "main": "dist/node/index.cjs",
  "module": "dist/node/index.js",
  "private": true,
  "repository": "immutable/ts-immutable-sdk.git",
  "scripts": {
    "build": "pnpm transpile && pnpm typegen",
    "test": "jest --passWithNoTests",
    "transpile": "tsup src/index.ts src/internal.ts --config ../../../tsup.config.js",
    "typecheck": "tsc --customConditions default --noEmit",
    "typegen": "tsc --customConditions default --emitDeclarationOnly --outDir dist/types"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
