{
  "name": "@imtbl/audience",
  "description": "Immutable Audience — consent-aware event tracking and identity management",
  "version": "0.0.0",
  "author": "Immutable",
  "browser": "dist/browser/index.js",
  "bugs": "https://github.com/immutable/ts-immutable-sdk/issues",
  "dependencies": {
    "@imtbl/audience-core": "workspace:*",
    "@imtbl/metrics": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "catalog:toolchain",
    "@swc/jest": "catalog:toolchain",
    "@types/jest": "catalog:toolchain",
    "@types/node": "catalog:toolchain",
    "@typescript/native": "catalog:toolchain",
    "jest": "catalog:toolchain",
    "jest-environment-jsdom": "catalog:toolchain",
    "rollup": "^4.22.4",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-polyfill-node": "catalog:toolchain",
    "typescript": "catalog:toolchain"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    "development": {
      "types": "./src/index.ts",
      "browser": "./dist/browser/index.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.js"
    },
    "default": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/immutable/ts-immutable-sdk#readme",
  "main": "dist/node/index.cjs",
  "module": "dist/node/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": "immutable/ts-immutable-sdk.git",
  "scripts": {
    "build": "pnpm transpile && pnpm transpile:cdn && pnpm typegen",
    "pack:root": "pnpm pack --pack-destination $(dirname $(pnpm root -w))",
    "postpack": "node scripts/postpack.mjs",
    "prepack": "node scripts/prepack.mjs",
    "test": "jest --passWithNoTests && pnpm test:cdn-artifact",
    "test:cdn-artifact": "pnpm transpile:cdn && jest --config jest.cdn-artifact.config.ts",
    "test:watch": "jest --watch",
    "transpile": "tsdown",
    "transpile:cdn": "tsdown --config ./tsdown.cdn.js",
    "typecheck": "tsc --customConditions development --noEmit --jsx preserve",
    "typegen": "tsc --customConditions default --emitDeclarationOnly --outDir dist/types && rollup -c rollup.dts.config.js && find dist/types -name '*.d.ts' ! -name 'index.d.ts' -delete"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
