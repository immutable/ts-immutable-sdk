{
  "name": "@imtbl/pixel",
  "description": "Immutable Tracking Pixel — drop-in JavaScript snippet for device fingerprint, page view, and attribution data",
  "version": "0.4.0",
  "author": "Immutable",
  "bugs": "https://github.com/immutable/ts-immutable-sdk/issues",
  "dependencies": {
    "@imtbl/audience-core": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "catalog:toolchain",
    "@swc/jest": "catalog:toolchain",
    "@types/jest": "catalog:toolchain",
    "@typescript/native": "catalog:toolchain",
    "jest": "catalog:toolchain",
    "jest-environment-jsdom": "catalog:toolchain",
    "typescript": "catalog:toolchain"
  },
  "exports": {
    "development": {
      "types": "./src/index.ts",
      "default": "./dist/imtbl.js"
    },
    "default": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/imtbl.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/immutable/ts-immutable-sdk#readme",
  "main": "dist/imtbl.js",
  "private": true,
  "repository": "immutable/ts-immutable-sdk.git",
  "scripts": {
    "build": "pnpm transpile && pnpm typegen",
    "test": "jest --passWithNoTests",
    "transpile": "tsdown",
    "typecheck": "tsc --customConditions development --noEmit",
    "typegen": "tsc --customConditions development --emitDeclarationOnly --outDir dist/types"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
