{
  "name": "@imtbl/checkout-sdk",
  "description": "Immutable Checkout SDK",
  "version": "0.0.0",
  "author": "immutable",
  "browser": "dist/browser/index.js",
  "bugs": "https://github.com/immutable/ts-immutable-sdk/issues",
  "dependencies": {
    "@imtbl/blockchain-data": "workspace:*",
    "@imtbl/bridge-sdk": "workspace:*",
    "@imtbl/config": "workspace:*",
    "@imtbl/dex-sdk": "workspace:*",
    "@imtbl/generated-clients": "workspace:*",
    "@imtbl/orderbook": "workspace:*",
    "@imtbl/passport": "workspace:*",
    "@metamask/detect-provider": "catalog:web3",
    "axios": "catalog:web3",
    "ethers": "catalog:web3",
    "semver": "^7.4.0",
    "uuid": "catalog:web3"
  },
  "devDependencies": {
    "@swc/core": "catalog:toolchain",
    "@swc/jest": "catalog:toolchain",
    "@types/jest": "catalog:toolchain",
    "@types/node": "catalog:toolchain",
    "@types/semver": "^7.5.8",
    "@types/uuid": "catalog:web3",
    "@typescript/native": "catalog:toolchain",
    "jest": "catalog:toolchain",
    "jest-environment-jsdom": "catalog:toolchain",
    "rollup-plugin-polyfill-node": "catalog:toolchain",
    "typedoc-plugin-markdown": "^4.2.3",
    "typescript": "catalog:toolchain"
  },
  "exports": {
    "development": {
      "types": "./src/index.ts",
      "browser": "./dist/browser/index.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.js"
    },
    "default": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/immutable/ts-immutable-sdk",
  "keywords": [
    "immutable"
  ],
  "license": "Apache-2.0",
  "main": "dist/node/index.cjs",
  "module": "dist/node/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": "immutable/ts-immutable-sdk.git",
  "scripts": {
    "build": "NODE_ENV=production pnpm transpile && pnpm typegen",
    "build:dev": "CHECKOUT_DEV_MODE=true pnpm build",
    "docs": "typedoc --plugin typedoc-plugin-markdown --skipErrorChecking --disableSources --out docs src/index.ts",
    "pack:root": "pnpm pack --pack-destination $(dirname $(pnpm root -w))",
    "start": "tsdown --watch",
    "start:dev": "CHECKOUT_DEV_MODE=true pnpm start",
    "test": "jest test",
    "test:watch": "jest test --watch",
    "transpile": "tsdown",
    "typecheck": "tsc --customConditions default --noEmit",
    "typegen": "tsc --customConditions default --emitDeclarationOnly --outDir dist/types"
  },
  "source": "src/index.ts",
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
