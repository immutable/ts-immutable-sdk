{
  "name": "@imtbl/game-bridge",
  "version": "0.0.0",
  "browserslist": [
    "Chrome 137"
  ],
  "dependencies": {
    "@imtbl/config": "workspace:*",
    "@imtbl/metrics": "workspace:*",
    "@imtbl/passport": "workspace:*",
    "buffer": "^6.0.3",
    "ethers": "catalog:web3"
  },
  "devDependencies": {
    "parcel": "^2.13.3"
  },
  "scripts": {
    "build": "parcel build --no-cache --no-scope-hoist && node scripts/fixUnityBuild.js",
    "build:local": "parcel build --no-cache --no-scope-hoist && node scripts/fixUnityBuild.js && pnpm updateSdkVersion",
    "start": "parcel",
    "updateSdkVersion": "./scripts/updateSdkVersion.sh"
  },
  "source": "src/index.html",
  "targets": {
    "unity": {
      "context": "browser",
      "source": "src/index.html",
      "outputFormat": "global",
      "scopeHoist": false,
      "isLibrary": false,
      "engines": {
        "browsers": "Chrome 137"
      }
    },
    "unreal": {
      "outputFormat": "global",
      "context": "browser",
      "source": "src/index.ts",
      "scopeHoist": false,
      "isLibrary": false,
      "engines": {
        "browsers": "Chrome 137"
      }
    }
  }
}
