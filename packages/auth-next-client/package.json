{
  "name": "@imtbl/auth-next-client",
  "description": "Immutable Auth.js v5 integration for Next.js - Client-side components",
  "version": "0.0.0",
  "author": "Immutable",
  "dependencies": {
    "@imtbl/auth": "workspace:*",
    "@imtbl/auth-next-server": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "catalog:toolchain",
    "@swc/jest": "catalog:toolchain",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@types/jest": "catalog:toolchain",
    "@types/node": "catalog:toolchain",
    "@types/react": "catalog:react",
    "@typescript/native": "catalog:toolchain",
    "jest": "catalog:toolchain",
    "next": "catalog:react",
    "next-auth": "catalog:react",
    "react": "catalog:react",
    "typescript": "catalog:toolchain"
  },
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "require": "./dist/node/index.cjs",
        "default": "./dist/node/index.js"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "require": "./dist/node/index.cjs",
        "default": "./dist/node/index.js"
      }
    }
  },
  "license": "Apache-2.0",
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.js",
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "next-auth": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "immutable/ts-immutable-sdk.git",
  "scripts": {
    "build": "pnpm transpile && pnpm typegen",
    "pack:root": "pnpm pack --pack-destination $(dirname $(pnpm root -w))",
    "test": "jest --passWithNoTests",
    "transpile": "tsdown",
    "typecheck": "tsc --customConditions default --noEmit --jsx preserve",
    "typegen": "tsc --customConditions default --emitDeclarationOnly --outDir dist/types"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
