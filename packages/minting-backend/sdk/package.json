{
  "name": "@imtbl/minting-backend",
  "description": "minting backend utilising Immutable Minting API",
  "version": "0.0.0",
  "author": "Immutable",
  "bugs": "https://github.com/immutable/ts-immutable-sdk/issues",
  "dependencies": {
    "@imtbl/blockchain-data": "workspace:*",
    "@imtbl/config": "workspace:*",
    "@imtbl/generated-clients": "workspace:*",
    "@imtbl/webhook": "workspace:*",
    "uuid": "catalog:web3"
  },
  "devDependencies": {
    "@swc/core": "catalog:toolchain",
    "@swc/jest": "catalog:toolchain",
    "@testcontainers/postgresql": "^10.9.0",
    "@types/jest": "catalog:toolchain",
    "@types/pg": "^8.11.5",
    "@types/uuid": "catalog:web3",
    "@typescript/native": "catalog:toolchain",
    "jest": "catalog:toolchain",
    "testcontainers": "^10.9.0",
    "typescript": "catalog:toolchain"
  },
  "exports": {
    "development": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "default": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/immutable/ts-immutable-sdk#readme",
  "license": "Apache-2.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "optionalDependencies": {
    "pg": "^8.11.5",
    "prisma": "^5.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "immutable/ts-immutable-sdk.git",
  "scripts": {
    "build": "pnpm transpile && pnpm typegen",
    "pack:root": "pnpm pack --pack-destination $(dirname $(pnpm root -w))",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "transpile": "tsdown",
    "typecheck": "tsc --customConditions default --noEmit --jsx preserve",
    "typegen": "tsc --customConditions default --emitDeclarationOnly --outDir dist/types"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
